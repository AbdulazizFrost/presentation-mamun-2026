# Port of the Node.js server (Express + Socket.IO) in development; Vite proxies /socket.io to it.
SERVER_PORT=3001

# Production port (npm start). Hosting platforms usually set PORT themselves; it falls back to SERVER_PORT.
# PORT=3001

# Port of the Vite dev server (development only).
CLIENT_PORT=5173

# Public HTTPS address of the deployed game, without a trailing slash.
# The QR code on the projector points to PUBLIC_URL/join?room=CODE.
# Leave empty for local testing: the QR then uses this laptop's LAN address and the host screen shows a warning.
PUBLIC_URL=
